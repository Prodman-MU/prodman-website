# ProdMan Club Website — Environment Variables
# Copy this file to .env.local and fill in the values.

# Newsletter signup backend (when implemented)
# NEWSLETTER_API_KEY=
# NEWSLETTER_LIST_ID=

# Event registration backend (when implemented)
# REGISTRATION_API_KEY=

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# Set in Vercel (Production only) so dev/preview traffic is not counted.
# NEXT_PUBLIC_GA_ID=
